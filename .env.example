# Base URL of the delaplak-server API.
#
# - iOS simulator / web: http://localhost:3001 (the default if this var is unset)
# - Android emulator: http://10.0.2.2:3001 is used automatically as the default on Android,
#   since the emulator can't resolve "localhost" back to the host machine.
# - Physical device (iOS or Android) on the same Wi-Fi network: set this explicitly to your
#   host machine's LAN IP, e.g. http://192.168.1.23:3001
EXPO_PUBLIC_API_URL=http://localhost:3001
